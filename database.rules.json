{
  "rules": {
    "nd_presence": {
      ".read": "auth != null",
      ".indexOn": ["name"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "nd_session_names": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "nd_contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$contactUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $contactUid)"
        }
      }
    },
    "nd_msgs": {
      "$convoId": {
        ".read": "auth != null && $convoId.contains(auth.uid)",
        ".write": "auth != null && $convoId.contains(auth.uid)",
        ".indexOn": ["ts"]
      }
    },
    "nd_typing": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "nd_signal": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "nd_vault": {
      "$vaultId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
